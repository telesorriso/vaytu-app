# =============================================================================
# VAYTU — Environment variables (Application Foundation phase)
# =============================================================================
# Copy this file to `.env.local` (already gitignored — never commit it) and
# fill in the two values below.
#
# Both are PUBLIC, browser-safe values — the `NEXT_PUBLIC_` prefix means
# Next.js bundles them into client-side JS by design. Neither grants any
# privilege beyond what Row Level Security allows for an anonymous/
# authenticated request; see /supabase/migrations/004_rls_policies.sql and
# /docs/SECURITY_MODEL.md.
#
# Where to find them: Supabase Dashboard → your Vaytu project → Project
# Settings → API. "Project URL" -> NEXT_PUBLIC_SUPABASE_URL. Under
# "Project API keys", the "anon" / "publishable" key (NOT "service_role")
# -> NEXT_PUBLIC_SUPABASE_ANON_KEY.
#
# NEVER put the service_role key in this file, in any NEXT_PUBLIC_* variable,
# in the repository, or anywhere reachable by client-side code. It bypasses
# Row Level Security entirely and is for trusted server-side use only
# (outside of this app, at this stage — no server-only Supabase admin
# operations exist yet in the Application Foundation phase).
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
