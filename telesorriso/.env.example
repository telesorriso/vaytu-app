# =============================================================================
# TELESORRISO — variabili d'ambiente
# =============================================================================
# In produzione si impostano in Netlify → Site configuration → Environment
# variables. In locale si possono esportare nel terminale prima di
# `npm run dev`. NON committare mai valori reali.

# --- Notifica email del lead (SOLO lato server, mai esposte al browser) ---
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=segreteria@esempio.it
LEAD_FROM_EMAIL="Telesorriso <lead@tuo-dominio-verificato.it>"
# "true" = non invia l'email, la stampa nei log (solo test/anteprime)
LEAD_EMAIL_DRY_RUN=

# --- Build (pubbliche: finiscono nell'HTML/JS) ---
# URL canonico del sito, senza barra finale. Default: variabile URL di Netlify.
SITE_URL=https://www.telesorriso.it
# ID contenitore Google Tag Manager. Vuoto = nessun tracker e nessun banner.
GTM_ID=
